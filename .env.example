# Twin platform — local development environment
#
# Copy this file to `.env` in the repo root and fill in real values.
# This single root .env is read by: infra/docker-compose.yml, packages/db
# (migrations), and apps/api. Keeping one file avoids drift between
# services during Phase 1 — revisit once services deploy independently.

# --- Postgres (used by docker-compose and the API) ---
POSTGRES_USER=twin
POSTGRES_PASSWORD=twin_dev_password
POSTGRES_DB=twin_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://twin:twin_dev_password@localhost:5432/twin_dev

# --- API (apps/api) ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT signing secret for access tokens — dev-only placeholder below.
# Generate a real random value for anything beyond local dev, e.g.:
#   openssl rand -hex 32
# Refresh tokens are NOT JWTs (opaque random bytes, hashed at rest —
# see apps/api/src/modules/auth/tokens.ts), so there is no separate
# refresh secret to configure.
JWT_ACCESS_SECRET=dev_access_secret_change_me_before_deploying

# --- Ingestion AI extraction (apps/api, Phase 5) ---
# 'heuristic' (default) does non-AI entity-mention linking only — no
# key required, no network calls. Set to 'gemini' to enable the real
# AI extraction pipeline; GEMINI_API_KEY then becomes required (the
# server refuses to start without it — see apps/api/src/config/env.ts).
# Server-side only — never sent to or readable by the frontend.
EXTRACTION_PROVIDER=heuristic
# GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=90000

# --- Memory embeddings (apps/api, Phase 6) ---
# 'none' (default) never generates embeddings — semantic search then
# has nothing to search over, and retrieval falls back to lexical +
# entity-aware signals only. Set to 'gemini' to enable real embeddings
# (uses the same GEMINI_API_KEY above); requires it to be set, same
# fail-loud pattern as EXTRACTION_PROVIDER.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_TIMEOUT_MS=30000

# --- Reasoning provider (apps/api, Phase 18) ---
# 'none' (default) falls back to MockReasoningProvider — deterministic,
# template-based, never a real LLM call — for POST /reason. Set to
# 'gemini' to enable real grounded reasoning over a ContextPacket (uses
# the same GEMINI_API_KEY above); requires it to be set, same fail-loud
# pattern as EXTRACTION_PROVIDER/EMBEDDING_PROVIDER.
REASONING_PROVIDER=none
REASONING_MODEL=gemini-3.6-flash
REASONING_TIMEOUT_MS=30000

# --- Background worker (apps/api/src/worker.ts, Phase 47) ---
# How often the scheduler cycle runs. The database's unique
# constraints, not this interval, are what actually prevent duplicate
# notifications — see README.md's "Running the background worker".
WORKER_INTERVAL_MS=60000

# --- Web Push (apps/api/src/worker/push.ts, Phase 47) ---
# All three optional together: unset means background push delivery is
# honestly skipped (notifications are still generated/persisted, and
# foreground browser notifications still work while a tab is open).
# Generate a real keypair with `npx web-push generate-vapid-keys` — a
# self-generated pair, not a third-party credential; safe to create
# fresh per environment. VAPID_PRIVATE_KEY must never be exposed to the
# frontend or logged. Requires HTTPS in production (localhost excepted).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
